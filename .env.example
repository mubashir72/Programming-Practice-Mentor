DATABASE_URL=sqlite:///./mentor.db
LLM_API_KEY=
LLM_BASE_URL=https://api.hcnsec.cn/v1
LLM_MODEL=DeepSeek-V4-Pro
APP_ENV=development

# Code execution sandbox. Docker is required for learner-code execution.
SANDBOX_MODE=docker
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MEMORY=128m
SANDBOX_CPUS=0.5

# Firebase Authentication and Firestore. Keep the service account JSON secret.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
